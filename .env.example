# GitHub — token needs Issues write + Contents read permissions.
# No Copilot API access required — Copilot acts on issues natively in GitHub.
GITHUB_TOKEN=ghp_...

# JFrog Xray webhook shared secret
# Set the same value in your Xray webhook config (used for HMAC-SHA256 verification).
# Leave empty to skip verification (dev mode only).
XRAY_WEBHOOK_SECRET=your-shared-secret

# JFrog Xray REST API (used to enrich CVE data; optional if webhook payload is sufficient)
JFROG_URL=https://yourinstance.jfrog.io
JFROG_USERNAME=your-username
JFROG_PASSWORD=your-password
# OR use API key instead:
# JFROG_API_KEY=your-api-key

# GitHub Issue config (optional — these are the defaults)
ISSUE_LABEL=security
ISSUE_LABEL_AUTOFIX=copilot-autofix
# ISSUE_ASSIGNEES=user1,user2   # comma-separated GitHub usernames

# Minimum severity to act on: Low | Medium | High | Critical (default: Medium)
MIN_SEVERITY=Medium
